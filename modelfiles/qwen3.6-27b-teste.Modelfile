# qwen3.6-27b-teste — gerador do Mini RAG (tier pesado / denso)
# Base: qwen3.6:27b (denso, ~17 GB, 256K ctx). Reasoning toggle nativo (testar separado p/ não quebrar comparação).
# Criar:  ollama create qwen3.6-27b-teste -f qwen3.6-27b-teste.Modelfile
FROM qwen3.6:27b
PARAMETER temperature 0.1
PARAMETER top_p 0.9
PARAMETER top_k 20
PARAMETER repeat_penalty 1.05
PARAMETER num_ctx 16384
