# Copie para .env e ajuste:  cp .env.example .env
# O .env NÃO deve ser versionado (já está no .gitignore).

# --- Postgres ---
# O docker-compose EXIGE estes nomes (POSTGRES_USER/PASSWORD/DB) para criar o banco.
# A app Go reaproveita os mesmos para montar a DSN.
POSTGRES_USER=rag
POSTGRES_PASSWORD=********
POSTGRES_DB=mini_rag
POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1        # usado SÓ pela app (conecta de fora do container)

# --- ollama (API local) ---
LLM_URL=http://127.0.0.1:11434
LLM_MODEL=gemma4-12b-teste:latest   # modelo de geração escolhido na pesquisa (ver modelfiles/)
EMBED_MODEL=bge-m3:latest           # modelo de embedding

# --- RAG ---
CHUNK_SIZE=400                 # tamanho-alvo do chunk (tokens)
TOP_K=5                        # nº de chunks recuperados por pergunta

# --- HTTP (chi) ---
HTTP_PORT=8080
